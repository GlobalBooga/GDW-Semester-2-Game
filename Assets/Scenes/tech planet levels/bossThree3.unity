  enemiesGoToPoint: {fileID: 628082654}
  boss: {fileID: 1772910671}
  skipCutscene: 0
  enableDialogue: 1
  enterScript:
  - name: Adana
    rightSide: 0
    speakerImage: {fileID: 21300000, guid: 963c17d939b2dc14e942441d2e865176, type: 3}
    sentences:
    - Oh, now that is not what I expected
  - name: Satchel
    rightSide: 1
    speakerImage: {fileID: 21300000, guid: bcec055340ce8cf448fd9ae7e21d4ff1, type: 3}
    sentences:
    - "...What\u2019s up? Oh you\u2019re there already! Awesome! Where\u2019s Gluttony?"
  - name: Adana
    rightSide: 0
    speakerImage: {fileID: 21300000, guid: 963c17d939b2dc14e942441d2e865176, type: 3}
    sentences:
    - "Uh, I think THAT\u2019S Gluttony\u2026"
  noticedScript:
  - name: Engineer
    rightSide: 1
    speakerImage: {fileID: 21300000, guid: 9bdbc70ff8f95a44c8a2799114f3f98a, type: 3}
    sentences:
    - "HEY WHO\u2019S THAT?!"
    - G- GO GO G-GET IN THE Z-0!!!
  fightStartScript: []
  endScript:
  - name: Satchel
    rightSide: 1
    speakerImage: {fileID: 21300000, guid: bcec055340ce8cf448fd9ae7e21d4ff1, type: 3}
    sentences:
    - "I don\u2019t even know where to start."
  - name: Adana
    rightSide: 0
    speakerImage: {fileID: 21300000, guid: 963c17d939b2dc14e942441d2e865176, type: 3}
    sentences:
    - "I know, I\u2019m the best."
  - name: Satchel
    rightSide: 1
    speakerImage: {fileID: 21300000, guid: bcec055340ce8cf448fd9ae7e21d4ff1, type: 3}
    sentences:
    - This is no time to joke!
    - Did you see how cool that thing was!?
