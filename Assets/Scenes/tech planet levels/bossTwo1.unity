  lightsContainer: {fileID: 448504093}
  bossName: THE SCREECHING VALKYRIE
  enableDialogue: 1
  doorsClosedScript:
  - name: ???
    rightSide: 1
    speakerImage: {fileID: 21300000, guid: fe094b95a3bd1924095350950ef5ccfd, type: 3}
    sentences:
    - HA! To think the prodigy valkyrie herself would fall for such an obvious bait
      like this.
    - Have you gotten rusty old friend?
  - name: Adana
    rightSide: 0
    speakerImage: {fileID: 21300000, guid: 963c17d939b2dc14e942441d2e865176, type: 3}
    sentences:
    - Squadron Leader!?
    - "You know what? Fair play. I\u2019ll show you just how polished my gun is."
  endScript:
  - name: Satchel
    rightSide: 1
    speakerImage: {fileID: 21300000, guid: bcec055340ce8cf448fd9ae7e21d4ff1, type: 3}
    sentences:
    - "I can\u2019t believe I got led by the nose like that. Adana, I'm so sorry."
    - "I\u2019ll fix this. I\u2019ll find where Andaroz actually is and you go get
      him."
  audioSource: {fileID: 1561094527}
  bossTheme: {fileID: 8300000, guid: fa758953403a34446b1d0d9778284d20, type: 3}
