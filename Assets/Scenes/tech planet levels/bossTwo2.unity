MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1926558875}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d89c95e4879497445a0ce46e080a24b2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sceneObjectives: 02000000
  cameraSize: 10
  isIndoors: 0
  enableDialogue: 1
  introScript:
  - name: Satchel
    rightSide: 1
    speakerImage: {fileID: 21300000, guid: bcec055340ce8cf448fd9ae7e21d4ff1, type: 3}
    sentences:
    - "Aaaaaalright, our intel says Andaroz is just a few blocks away but you\u2019ll
      have to fight your way there."
  - name: Adana
    rightSide: 0
    speakerImage: {fileID: 21300000, guid: 963c17d939b2dc14e942441d2e865176, type: 3}
    sentences:
    - "That ain\u2019t even a problem. It\u2019ll be a nice warm up."
  - name: Satchel
    rightSide: 1
    speakerImage: {fileID: 21300000, guid: bcec055340ce8cf448fd9ae7e21d4ff1, type: 3}
    sentences:
    - "You sure you\u2019re okay to face him?"
  - name: Adana
    rightSide: 0
    speakerImage: {fileID: 21300000, guid: 963c17d939b2dc14e942441d2e865176, type: 3}
    sentences:
    - "I\u2019ve been waiting for this moment ever since I left the empire. My blood
      is boiling."
